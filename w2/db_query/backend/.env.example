# LLM API Key for natural language to SQL conversion
# 支持 OpenAI、DeepSeek 等兼容 API
OPENAI_API_KEY=sk-your-api-key-here

# 可选：使用 DeepSeek 时取消注释并配置
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
